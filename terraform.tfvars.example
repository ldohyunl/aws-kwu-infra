# ==============================================================
# KWU AWS 실습 환경 변수 설정
# 사용법: 이 파일을 terraform.tfvars 로 복사하고 값 수정
#   cp terraform.tfvars.example terraform.tfvars
# ==============================================================

# AWS 리전 (변경 불필요)
aws_region = "ap-northeast-2"

# EC2 키 페어 이름 (AWS 콘솔에서 미리 만들어 둔 키 이름)
key_name = "kwuaws"

# 본인이 구매한 도메인 (가비아 등에서 구매)
my_domain = "your-domain.com"

# EC2 인스턴스 유형 (변경 불필요)
instance_type = "t3.micro"
